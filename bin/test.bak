#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/.."

# Remove cache for safety
rm -rf output .spago .cache ../gopurs-*/output ../gopurs-*/.spago ../gopurs-*/.cache

rm -f spago.yaml
ln -s spago.go.yaml spago.yaml

echo "=== Building project with spago ==="
spago build || { echo "Spago build failed"; exit 1; }

echo "=== Generating Go code with gopurs ==="
node ../gopurs/bin/gopurs.js --main Test.Main || exit 1

echo "=== Compiling and running Go test binary ==="
if [ -d "output/Test.Main" ]; then
    cd output
    
    # Patch QuickCheck float32ToInt32 FFI if present
    if [ -f "Test.QuickCheck.Gen/Test_QuickCheck_Gen_ffi.go" ]; then
        sed -i.bak 's/var _Gopurs_Float32ToInt32 = .*/var _Gopurs_Float32ToInt32 = gopurs_runtime.Func(func(v gopurs_runtime.Value) gopurs_runtime.Value { return gopurs_runtime.Int(int64(int32(gopurs_runtime.Unbox[float64](v)))) })/' Test.QuickCheck.Gen/Test_QuickCheck_Gen_ffi.go
    fi
    
    sed -i.bak 's/go_arg0 := gopurs_runtime.Unbox\[int\](arg0)/if arg0.Type == 13 { panic(fmt.Sprintf("ToNumber called with TypeAny! val: %#v", arg0)) }\\n\\tgo_arg0 := gopurs_runtime.Unbox[int](arg0)/' Data.Int/Data_Int_ffi.go

    rm -f go.mod
    go mod init gopurs/output > /dev/null 2>&1
    go mod tidy > /dev/null 2>&1
    go build -o go_test_app ./Test.Main/main
    cd ..
    
    GOGC=1000 ./output/go_test_app
else
    echo "No output/Test.Main/main found."
    exit 1
fi
echo -e "\n✅ Tests passed successfully!"
